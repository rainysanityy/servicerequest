# =============================================================================
#  IT-Service-Request-Portal – Umgebungsvariablen (Vorlage)
#  Kopieren nach .env  ->  cp .env.example .env && chmod 600 .env
#  NIEMALS echte Secrets ins Repository einchecken (.env ist in .gitignore).
#  Datenbank-Passwörter der Portal-DB liegen als Docker-Secrets in ./secrets/
#  (Erzeugung: ./scripts/init-secrets.sh).
# =============================================================================

# --- Allgemein ---------------------------------------------------------------
PORTAL_VERSION=1.0.0
# Öffentlicher FQDN des Portals (muss zum TLS-Zertifikat passen)
PORTAL_HOSTNAME=portal.example.local
LOG_LEVEL=info

# --- Reverse Proxy -----------------------------------------------------------
# Rootless-Betrieb: hohe Ports, firewalld leitet 443 -> 8443 und 80 -> 8080 weiter
PROXY_HTTPS_PORT=8443
PROXY_HTTP_PORT=8080
# Netzbereich, aus dem die Keycloak-Admin-Konsole (/auth/admin) erreichbar ist
ADMIN_ALLOW_CIDR=10.10.0.0/24

# --- Keycloak ----------------------------------------------------------------
KEYCLOAK_VERSION=26.4
KEYCLOAK_REALM=itportal
# Nur für den ersten Start; danach temporären Admin löschen (siehe Betriebskonzept)
KEYCLOAK_ADMIN_USER=kc-bootstrap
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_min_20_chars_random
KEYCLOAK_DB_PASSWORD=CHANGE_ME_random
# Client-Secret des Service-Accounts "portal-admin-api" (Benutzer & Rollen im Admin-Bereich)
KEYCLOAK_ADMIN_API_SECRET=CHANGE_ME_random_min_32_chars

# --- Selbstregistrierung -------------------------------------------------------
# Selbstregistrierung (ohne Mailserver, ohne E-Mail-Bestätigung):
# Selbst registrierte Konten erhalten nur Zugriff, wenn die E-Mail-Adresse zu einer dieser
# Domains gehört (kommagetrennt). Leer = keine Einschränkung.
ALLOWED_EMAIL_DOMAINS=example.com

# --- Backend / OIDC ----------------------------------------------------------
OIDC_AUDIENCE=portal-api
OIDC_ALLOWED_AZP=portal-frontend
RATE_LIMIT_MAX=300

# --- Portal-Datenbank --------------------------------------------------------
PORTAL_DB_NAME=portal
# disable (internes, isoliertes Docker-Netz) | require | verify-full
DB_SSLMODE=disable

# --- Aufbewahrung / Löschfristen (Tage) - siehe Datenschutzkonzept ----------
# Abgeschlossene Tickets werden nach Ablauf anonymisiert
RETENTION_TICKET_DAYS=1095
# Audit-Log-Einträge werden nach Ablauf gelöscht
RETENTION_AUDIT_DAYS=365
# IP-Adressen im Audit-Log werden nach Ablauf entfernt
RETENTION_IP_DAYS=90

# --- Backup ------------------------------------------------------------------
BACKUP_DIR=/srv/backup/srp
# age-Public-Key (age1...) – privater Schlüssel liegt OFFLINE / im Tresor
BACKUP_AGE_RECIPIENT=age1replace_with_your_public_key
BACKUP_RETENTION_DAYS=30
