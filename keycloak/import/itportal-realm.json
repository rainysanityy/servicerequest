{
  "realm": "itportal",
  "displayName": "IT-Service-Portal",
  "enabled": true,
  "sslRequired": "all",
  "registrationAllowed": true,
  "resetPasswordAllowed": true,
  "rememberMe": false,
  "verifyEmail": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "failureFactor": 5,
  "passwordPolicy": "length(12) and upperCase(1) and lowerCase(1) and digits(1) and specialChars(1) and notUsername() and notEmail() and passwordHistory(5) and hashIterations(210000)",
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA256",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "accessTokenLifespan": 300,
  "accessTokenLifespanForImplicitFlow": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "offlineSessionIdleTimeout": 2592000,
  "offlineSessionMaxLifespanEnabled": true,
  "offlineSessionMaxLifespan": 2592000,
  "accessCodeLifespan": 60,
  "accessCodeLifespanLogin": 1800,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "defaultSignatureAlgorithm": "RS256",
  "internationalizationEnabled": true,
  "supportedLocales": [
    "de",
    "en"
  ],
  "defaultLocale": "de",
  "eventsEnabled": true,
  "eventsExpiration": 7776000,
  "enabledEventTypes": [
    "LOGIN",
    "LOGIN_ERROR",
    "LOGOUT",
    "LOGOUT_ERROR",
    "CODE_TO_TOKEN",
    "CODE_TO_TOKEN_ERROR",
    "REFRESH_TOKEN_ERROR",
    "UPDATE_PASSWORD",
    "UPDATE_TOTP",
    "REMOVE_TOTP",
    "UPDATE_PROFILE",
    "RESET_PASSWORD",
    "RESET_PASSWORD_ERROR",
    "USER_DISABLED_BY_TEMPORARY_LOCKOUT",
    "USER_DISABLED_BY_PERMANENT_LOCKOUT"
  ],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true,
  "browserSecurityHeaders": {
    "contentSecurityPolicyReportOnly": "",
    "xContentTypeOptions": "nosniff",
    "referrerPolicy": "no-referrer",
    "xRobotsTag": "none",
    "xFrameOptions": "SAMEORIGIN",
    "contentSecurityPolicy": "frame-src 'self'; frame-ancestors 'self'; object-src 'none';",
    "strictTransportSecurity": "max-age=31536000; includeSubDomains"
  },
  "roles": {
    "realm": [
      {
        "name": "user",
        "description": "Mitarbeitende: Requests erstellen, eigene Tickets einsehen und kommentieren"
      },
      {
        "name": "first-level",
        "description": "First-Level-Support / User Help Desk: Tickets sichten, zuweisen, bearbeiten"
      },
      {
        "name": "admin",
        "description": "Portal-Administration: Katalog, Workflows, SLA, Audit"
      }
    ]
  },
  "groups": [
    {
      "name": "Mitarbeitende",
      "path": "/Mitarbeitende",
      "realmRoles": [
        "user"
      ]
    },
    {
      "name": "IT-UHD",
      "path": "/IT-UHD",
      "realmRoles": [
        "user",
        "first-level"
      ]
    },
    {
      "name": "IT-Portal-Admins",
      "path": "/IT-Portal-Admins",
      "realmRoles": [
        "user",
        "first-level",
        "admin"
      ]
    }
  ],
  "requiredActions": [
    {
      "alias": "CONFIGURE_TOTP",
      "name": "Configure OTP",
      "providerId": "CONFIGURE_TOTP",
      "enabled": true,
      "defaultAction": false,
      "priority": 10
    },
    {
      "alias": "UPDATE_PASSWORD",
      "name": "Update Password",
      "providerId": "UPDATE_PASSWORD",
      "enabled": true,
      "defaultAction": false,
      "priority": 30
    },
    {
      "alias": "VERIFY_EMAIL",
      "name": "Verify Email",
      "providerId": "VERIFY_EMAIL",
      "enabled": true,
      "defaultAction": false,
      "priority": 50
    }
  ],
  "clients": [
    {
      "clientId": "portal-frontend",
      "name": "IT-Service-Portal (SPA)",
      "description": "Öffentlicher OIDC-Client, Authorization Code Flow + PKCE (S256)",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "fullScopeAllowed": true,
      "rootUrl": "https://${PORTAL_HOSTNAME}",
      "baseUrl": "/",
      "redirectUris": [
        "https://${PORTAL_HOSTNAME}/*"
      ],
      "webOrigins": [
        "https://${PORTAL_HOSTNAME}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://${PORTAL_HOSTNAME}/*",
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false",
        "use.refresh.tokens": "true",
        "client_credentials.use_refresh_token": "false"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "basic",
        "email"
      ],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "audience-portal-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "portal-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "portal-api",
      "name": "IT-Service-Portal API (Resource Server)",
      "description": "Nur Audience-Ziel. Keine Flows aktiviert.",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "attributes": {}
    },
    {
      "clientId": "portal-admin-api",
      "name": "IT-Service-Portal Backend (Benutzerverwaltung)",
      "description": "Vertraulicher Client mit Service-Account: Backend verwaltet Gruppen (Rollen) und Sperrstatus von Benutzern im Realm itportal",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "secret": "${KEYCLOAK_ADMIN_API_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "attributes": {
        "access.token.lifespan": "120",
        "client_credentials.use_refresh_token": "false"
      },
      "defaultClientScopes": [
        "roles",
        "basic"
      ],
      "optionalClientScopes": []
    }
  ],
  "registrationEmailAsUsername": false,
  "defaultGroups": [
    "/Mitarbeitende"
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\": [{\"name\": \"username\", \"displayName\": \"${username}\", \"validations\": {\"length\": {\"min\": 3, \"max\": 64}, \"pattern\": {\"pattern\": \"^[a-z0-9._-]+$\", \"error-message\": \"Nur Kleinbuchstaben, Ziffern, Punkt, Unterstrich und Bindestrich\"}, \"username-prohibited-characters\": {}, \"up-username-not-idn-homograph\": {}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\"]}, \"multivalued\": false}, {\"name\": \"email\", \"displayName\": \"${email}\", \"validations\": {\"email\": {}, \"length\": {\"max\": 254}}, \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"firstName\", \"displayName\": \"${firstName}\", \"validations\": {\"length\": {\"max\": 60}, \"person-name-prohibited-characters\": {}}, \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"lastName\", \"displayName\": \"${lastName}\", \"validations\": {\"length\": {\"max\": 60}, \"person-name-prohibited-characters\": {}}, \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}], \"groups\": [{\"name\": \"user-metadata\", \"displayHeader\": \"User metadata\", \"displayDescription\": \"Attributes, which refer to user metadata\"}], \"unmanagedAttributePolicy\": \"ADMIN_VIEW\"}"
          ]
        }
      }
    ]
  },
  "users": [
    {
      "username": "service-account-portal-admin-api",
      "enabled": true,
      "serviceAccountClientId": "portal-admin-api",
      "clientRoles": {
        "realm-management": [
          "query-users",
          "view-users",
          "query-groups",
          "manage-users"
        ]
      }
    }
  ],
  "scopeMappings": [],
  "clientScopeMappings": {
    "realm-management": [
      {
        "client": "portal-admin-api",
        "roles": [
          "query-users",
          "view-users",
          "query-groups",
          "manage-users"
        ]
      }
    ]
  },
  "smtpServer": {
    "host": "${SMTP_HOST:mail.example.local}",
    "port": "${SMTP_PORT:587}",
    "from": "${SMTP_FROM:it-portal@example.local}",
    "fromDisplayName": "IT-Service-Portal",
    "starttls": "true",
    "ssl": "false",
    "auth": "false"
  },
  "loginTheme": "itportal"
}
